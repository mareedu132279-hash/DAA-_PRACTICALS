#include <iostream>
#include <climits>
using namespace std;

const int N = 4;

int cost[N][N] = {
    {0,  10, 15, 20},
    {10, 0,  35, 25},
    {15, 35, 0,  30},
    {20, 25, 30, 0}
};

int dp[1 << N][N];

int tsp(int mask, int pos) {
    if (mask == (1 << N) - 1)
        return cost[pos][0];

    if (dp[mask][pos] != -1)
        return dp[mask][pos];

    int ans = INT_MAX;

    for (int city = 0; city < N; city++) {
        if (!(mask & (1 << city))) {
            int newCost = cost[pos][city]
                        + tsp(mask | (1 << city), city);

            ans = min(ans, newCost);
        }
    }

    return dp[mask][pos] = ans;
}

int main() {
    for (int i = 0; i < (1 << N); i++)
        for (int j = 0; j < N; j++)
            dp[i][j] = -1;

    cout << "Minimum Travelling Cost: "
         << tsp(1, 0) << endl;

    cout << "Time Complexity: O(N^2 * 2^N)" << endl;
    cout << "Space Complexity: O(N * 2^N)" << endl;

    return 0;
}
