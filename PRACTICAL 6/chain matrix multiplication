#include <iostream>
#include <climits>
using namespace std;

int matrixChainOrder(int p[], int n)
{
    int m[n][n];

    for (int i = 1; i < n; i++)
        m[i][i] = 0;

    for (int L = 2; L < n; L++) // L = chain length
    {
        for (int i = 1; i < n - L + 1; i++)
        {
            int j = i + L - 1;
            m[i][j] = INT_MAX;

            for (int k = i; k < j; k++)
            {
                int q = m[i][k] + m[k + 1][j]
                        + p[i - 1] * p[k] * p[j];

                if (q < m[i][j])
                    m[i][j] = q;
            }
        }
    }

    return m[1][n - 1];
}

int main()
{
    int p[] = {10, 20, 30, 40, 30};

    int n = sizeof(p) / sizeof(p[0]);

    cout << "Matrix Dimensions: ";
    for (int i = 0; i < n; i++)
        cout << p[i] << " ";

    cout << "\nMinimum number of multiplications: "
         << matrixChainOrder(p, n) << endl;

    cout << "\nTime Complexity: O(n^3)";
    cout << "\nSpace Complexity: O(n^2)" << endl;

    return 0;
}
