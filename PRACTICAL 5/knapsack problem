#include <iostream>
#include <vector>
using namespace std;

int main()
{
    // Fixed values (No user input)
    int W = 50; // Knapsack capacity

    vector<int> weight = {10, 20, 30};
    vector<int> value = {60, 100, 120};

    int n = weight.size();

    // DP Table
    vector<vector<int>> dp(n + 1, vector<int>(W + 1, 0));

    // Build DP Table
    for (int i = 1; i <= n; i++)
    {
        for (int w = 1; w <= W; w++)
        {
            if (weight[i - 1] <= w)
            {
                dp[i][w] = max(
                    value[i - 1] + dp[i - 1][w - weight[i - 1]],
                    dp[i - 1][w]
                );
            }
            else
            {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    cout << "Knapsack Capacity = " << W << endl;

    cout << "Weights: ";
    for (int w : weight)
        cout << w << " ";
    cout << endl;

    cout << "Values: ";
    for (int v : value)
        cout << v << " ";
    cout << endl;

    cout << "\nMaximum Profit = " << dp[n][W] << endl;

    cout << "\nTime Complexity = O(n * W)" << endl;
    cout << "Space Complexity = O(n * W)" << endl;

    return 0;
} 
