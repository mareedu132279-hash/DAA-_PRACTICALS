#include <iostream>
#include <algorithm>
using namespace std;

struct Edge
{
    int u, v, w;
};

int parent[10];

// Find parent
int find(int i)
{
    while (parent[i] != i)
        i = parent[i];
    return i;
}

// Union of two sets
void Union(int a, int b)
{
    parent[a] = b;
}

int main()
{
    int vertices = 5;

    Edge edges[] = {
        {0, 1, 2},
        {0, 3, 6},
        {1, 2, 3},
        {1, 3, 8},
        {1, 4, 5},
        {2, 4, 7},
        {3, 4, 9}
    };

    int n = 7; // Number of edges

    // Initialize parent array
    for (int i = 0; i < vertices; i++)
        parent[i] = i;

    // Sort edges by weight
    sort(edges, edges + n, [](Edge a, Edge b)
    {
        return a.w < b.w;
    });

    int minCost = 0;

    cout << "Edges in MST:\n";

    for (int i = 0; i < n; i++)
    {
        int a = find(edges[i].u);
        int b = find(edges[i].v);

        if (a != b)
        {
            cout << edges[i].u << " - "
                 << edges[i].v << " : "
                 << edges[i].w << endl;

            minCost += edges[i].w;
            Union(a, b);
        }
    }

    cout << "\nMinimum Cost = " << minCost << endl;

    cout << "\nTime Complexity = O(E log E)" << endl;
    cout << "Space Complexity = O(V)" << endl;

    return 0;
}
