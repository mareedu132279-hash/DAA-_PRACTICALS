#include <iostream>
using namespace std;

int main() {
    int n;
    long long fact = 1;

    cout << "Enter a number: ";
    cin >> n;

    for(int i = 1; i <= n; i++) {
        fact = fact * i;
    }

    cout << "Factorial = " << fact << endl;
    cout << "Time Complexity = O(n)" << endl;
    cout << "Space Complexity = O(1)" << endl;

    return 0;
}
